# Every variable is optional; the defaults are in src/evilflowers_analyzer/settings.py.

REDIS_URL=redis://redis:6379/7
ANALYZER_QUEUE=evilflowers_analyzer
# Seconds before Redis redelivers an unacknowledged message. One value for every consumer of the Redis db (12 h):
# each consumer restores all unacked messages older than its own timeout, in any queue.
BROKER_VISIBILITY_TIMEOUT=43200
# Scale-in: seconds a SIGTERMed worker lets the book run before it cancels it and Redis requeues it at once.
# A book that finishes earlier is acknowledged and the worker exits; an idle worker exits at once.
WORKER_SOFT_SHUTDOWN_TIMEOUT=900
# If cancelling the book takes longer than this (the kill of the child can be denied), the worker requeues it and exits.
WORKER_CANCEL_TIMEOUT=30
# Deliveries of one run's extract before the run is failed instead of started again.
EXTRACT_MAX_PASSES=5
STORAGE_PATH=/mnt/data

# Queues of the services the analyzer dispatches to.
# Text has one queue per job (#4). The old shared TEXT_QUEUE is no longer read.
TEXT_TABLES_QUEUE=evilflowers.text.tables
TEXT_PARAGRAPHS_QUEUE=evilflowers.text.paragraphs
IMAGE_QUEUE=evilflowers_image
EQUATION_QUEUE=evilflowers_equation

# IP-018: the analyzer starts runs here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=
CATALOG_ATTEMPTS=4
CATALOG_TIMEOUT=120

# Docling layout: pages per conversion (bounds memory on long books) and CPU threads.
LAYOUT_BATCH_PAGES=16
LAYOUT_THREADS=4
# Region jobs per layout batch (equations:0001-0016 …) instead of per book. Needs services that report under `job`.
DISPATCH_PER_BATCH=false
# Docling's model cache (read by the Hugging Face libraries, not by settings.py); a volume in the image.
HF_HOME=/models

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=analyzer
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=analyzer
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=analyzer,cluster=k8s-stu
